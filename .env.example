# 「MatrixSolo」环境变量模板
# 复制为 .env 后填入真实密钥

# ---- 服务 ----
MATRIXSOLO_HOST=0.0.0.0
MATRIXSOLO_PORT=9797
MATRIXSOLO_DEBUG=true
MATRIXSOLO_DATA_DIR=./data
MATRIXSOLO_ASSETS_DIR=./Assets

# ---- LLM 网关（按优先级路由） ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Grsai OpenAI 兼容（国内 https://grsai.dakka.com.cn ；全球 https://grsaiapi.com ）
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn/v1
GRSAI_MODEL=gpt-5.4

LLM_DEFAULT_PROVIDER=grsai

# ---- 飞书 / Lark：五岗 AI 员工 ----
# 总编
FEISHU_STRATEGY_APP_ID=
FEISHU_STRATEGY_APP_SECRET=
# 文案
FEISHU_SCRIPT_APP_ID=
FEISHU_SCRIPT_APP_SECRET=
# 视觉
FEISHU_VISUAL_APP_ID=
FEISHU_VISUAL_APP_SECRET=
# 剪辑
FEISHU_EDITOR_APP_ID=
FEISHU_EDITOR_APP_SECRET=
# 运营
FEISHU_OPS_APP_ID=
FEISHU_OPS_APP_SECRET=

# 可选：通用回退（单岗未填时使用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 人机回环审批群 chat_id（五岗机器人需都拉进该群）
FEISHU_HITL_CHAT_ID=
# 多维表格 app_token / table_ids
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_CONTENT_CALENDAR=
FEISHU_TABLE_TASKS=
FEISHU_TABLE_ASSETS=
FEISHU_TABLE_METRICS=
FEISHU_TABLE_WORK_LOGS=

# ---- 向量库 ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=matrixsolo_rag
CHROMA_ENABLED=false

# ---- TTS / 媒体 ----
TTS_PROVIDER=edge
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
EDGE_TTS_VOICE=zh-CN-YunxiNeural
DIGITAL_HUMAN_MODE=slideshow

# ---- 本地 MCP ----
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_WORKSPACE=./Assets

# ---- 调度 ----
ENABLE_SCHEDULER=true
ENABLE_FEISHU_CHAT=true
HOT_RADAR_CRON=0 8,18 * * *
METRICS_SYNC_CRON=0 0 * * *
CACHE_CLEANUP_CRON=0 3 * * *
